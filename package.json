{
  "name": "corocam-shared",
  "version": "0.1.0",
  "description": "Shared CoroCam TCP protocol client and UI logic, used by rodxa and the tablet app (and future CoroCam clients).",
  "license": "UNLICENSED",
  "private": false,
  "type": "commonjs",
  "exports": {
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./ui-logic": {
      "types": "./dist/ui-logic/index.d.ts",
      "default": "./dist/ui-logic/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "xstate": "^5.32.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.2",
    "xstate": "^5.32.6"
  }
}
